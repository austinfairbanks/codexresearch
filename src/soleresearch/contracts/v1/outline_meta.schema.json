{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soleresearch.local/schemas/v1/outline_meta.schema.json",
  "title": "Historical Soleresearch Phase-1 outline metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "anchors"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "anchors": {"type": "object"}
  }
}
