    "run.operate.checkpoint": {"parser_signature": ["project|path|positional|required|single|null|-", "run_id|string|option|required|single|null|-", "controller_token_file|path|option|required|single|null|-", "path|string|option|required|repeatable|null|-", "message|string|option|required|single|null|-"], "constraints": ["Git isolation must be enabled; path is repeatable and every path must be explicit, confined, and unstaged before this command; message must be nonempty"]}
