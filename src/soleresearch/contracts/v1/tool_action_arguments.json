    "run.budget.extend": {"parser_signature": ["project|path|positional|required|single|null|-", "run_id|string|positional|required|single|null|-", "actor|enum|option|required|single|null|human,sol", "reason|string|option|required|single|null|-", "cycles|integer|option|optional|single|null|-", "tasks|integer|option|optional|single|null|-", "deep_sources|integer|option|optional|single|null|-", "minutes|number|option|optional|single|null|-", "provider_usage|number|option|optional|single|null|-", "controller_token_file|path|option|required|single|null|-"], "constraints": ["at least one positive delta among cycles, tasks, deep_sources, minutes, or provider_usage is required", "actor must match the active controller and the cumulative extension remains bounded"]},

