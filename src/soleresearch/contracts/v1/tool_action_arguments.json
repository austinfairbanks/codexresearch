    "core.tools.validate-result": {"parser_signature": ["file|path|option|required|single|null|-", "bundle|path|option|optional|single|null|-"] , "constraints": ["runs the canonical packaged v1 result schema and semantic preflight without admitting or mutating the result", "bundle-aware mode validates immutable task relationships, trusted local invocation time, scope, reservations, and bundled provenance", "no public option can override the trusted receipt clock"]},

