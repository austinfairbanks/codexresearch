    "run.operate.start": {"parser_signature": ["project|path|positional|required|single|null|-", "controller|enum|option|optional|single|\"human\"|human,sol", "cycles|integer|option|optional|single|3|-", "tasks|integer|option|optional|single|10|-", "deep_sources|integer|option|optional|single|15|-", "agents|integer|option|optional|single|4|-", "max_depth|integer|option|optional|single|1|-", "minutes|number|option|optional|single|90|-", "provider_unit|enum|option|optional|single|\"dollars\"|dollars,tokens,credits,rate_limit", "provider_ceiling|number|option|optional|single|5.0|-", "git_repository|path|option|optional|single|null|-", "worktree_parent|path|option|optional|single|null|-", "baseline_revision|string|option|optional|single|null|-", "allow_dirty_baseline|boolean|option|optional|single|false|-"], "constraints": ["cycles, tasks, deep_sources, agents, minutes, and provider_ceiling must be positive and within the global envelope; max_depth is 0 or 1; agents includes the orchestrator", "git_repository, worktree_parent, and baseline_revision are an all-or-none Git isolation triple; allow_dirty_baseline is valid only with that triple", "provider_unit determines the accounting unit and provider_ceiling is a hard cap, never a target"]},
    "run.operate.dispatch": {"parser_signature": ["project|path|positional|required|single|null|-", "run_id|string|option|required|single|null|-", "controller_token_file|path|option|required|single|null|-", "role|string|option|required|single|null|-", "subquestion|string|option|required|single|null|-", "evidence_strategy|string|option|required|single|null|-", "context|path|option|required|single|null|-", "artifact_ref|string|option|optional|repeatable|[]|-", "capability|string|option|optional|repeatable|[]|-", "domain|string|option|optional|repeatable|[]|-", "parent_task_id|string|option|optional|single|null|-", "reserve_deep_sources|integer|option|optional|single|0|-", "reserve_provider_usage|number|option|optional|single|0.0|-", "lease_minutes|number|option|optional|single|30.0|-"], "constraints": ["context must be a bounded JSON object with no secrets, capabilities, or canonical paths", "artifact_ref, capability, and domain are repeatable allowlists; every result use must be a subset", "parent_task_id increases depth and cannot exceed one nested worker level", "reservations are nonnegative and cannot overcommit shared remaining deep-source/provider budgets", "lease_minutes must be greater than 0 and at most 90"]},
    "run.operate.bundle-task": {"parser_signature": ["project|path|positional|required|single|null|-", "run_id|string|option|required|single|null|-", "controller_token_file|path|option|required|single|null|-", "task_id|string|option|required|single|null|-", "output|path|option|required|single|null|-"], "constraints": ["requires the active run controller and an existing immutable task", "contains only explicitly assigned source/evidence material and no controller secret or canonical project path", "source text is bounded and exposes material_truncated metadata", "output must not already exist"]},
