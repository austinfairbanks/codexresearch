{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soleresearch.local/schemas/v1/evidence.schema.json",
  "title": "Soleresearch exact-locator evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "source_id", "source_hash", "source_version", "locator", "excerpt", "retrieved_at", "attestations"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "evidence_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "source_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "source_hash": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "page", "section", "paragraph", "figure", "table", "timestamp", "start_char", "end_char", "label"],
      "properties": {
        "type": {"enum": ["page", "section", "paragraph", "captured_passage", "figure", "table", "timestamp"]},
        "page": {"type": ["integer", "null"]},
        "section": {"type": ["string", "null"]},
        "paragraph": {"type": ["integer", "null"]},
        "figure": {"type": ["string", "null"]},
        "table": {"type": ["string", "null"]},
        "timestamp": {"type": ["string", "null"]},
        "start_char": {"type": ["integer", "null"]},
        "end_char": {"type": ["integer", "null"]},
        "label": {"type": "string"}
      }
    },
    "excerpt": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "attestations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["attestation_id", "paraphrase", "stance", "run_id", "task_id", "actor_type", "actor_id", "method", "attested_at"],
        "properties": {
          "attestation_id": {"type": "string", "minLength": 1},
          "paraphrase": {"type": "string", "minLength": 1},
          "stance": {"enum": ["supports", "contradicts", "qualifies", "context", "uncertain"]},
          "run_id": {"type": ["string", "null"]},
          "task_id": {"type": ["string", "null"]},
          "actor_type": {"enum": ["human", "agent", "import"]},
          "actor_id": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "attested_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
