{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soleresearch.local/schemas/v1/reconciliation_event.schema.json",
  "title": "Soleresearch durable outline reconciliation event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "actor_id", "base_outline_hash", "current_outline_hash", "result_outline_hash", "base_graph_revision", "result_graph_revision", "semantic_changes", "affected_proposals", "conflict_ids", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "event_id": {"type": "string", "pattern": "^rec_[0-9a-f]{32}$"},
    "actor_id": {"type": "string", "minLength": 1},
    "base_outline_hash": {"type": "string", "minLength": 1},
    "current_outline_hash": {"type": "string", "minLength": 1},
    "result_outline_hash": {"type": "string", "minLength": 1},
    "base_graph_revision": {"type": "integer", "minimum": 0},
    "result_graph_revision": {"type": "integer", "minimum": 0},
    "semantic_changes": {"type": "array", "items": {"type": "object"}},
    "affected_proposals": {"type": "array", "items": {"type": "object"}},
    "conflict_ids": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
