{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Soleresearch human outline edit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "project_id",
    "before_hash",
    "after_hash",
    "semantic_summary",
    "actor",
    "created_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "event_id": {"type": "string", "pattern": "^hed_[0-9a-f]{32}$"},
    "event_type": {"type": "string", "const": "human_outline_edit"},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "before_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "after_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semantic_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_node_ids", "title_changes", "body_changes", "parent_changes", "position_changes"],
      "properties": {
        "changed_node_ids": {"type": "array", "items": {"type": "string", "pattern": "^nod_[0-9a-f]{32}$"}},
        "title_changes": {"type": "integer", "minimum": 0},
        "body_changes": {"type": "integer", "minimum": 0},
        "parent_changes": {"type": "integer", "minimum": 0},
        "position_changes": {"type": "integer", "minimum": 0}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "authority", "capability_id"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "const": "human_accepted"},
        "capability_id": {"type": "string", "pattern": "^cap_[0-9a-f]{32}$"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
